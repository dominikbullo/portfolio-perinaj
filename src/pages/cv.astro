---
import { siteConfig } from "../config";
const year = new Date().getFullYear();
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{siteConfig.name} — CV</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #f9f7eb;
      --green: #1f4c34;
      --text-secondary: rgba(31, 76, 52, 0.65);
      --text-muted: rgba(31, 76, 52, 0.4);
      --border: rgba(31, 76, 52, 0.15);
      --sage: #94A187;
      --sage-soft: rgba(148, 161, 135, 0.15);
      --white: #ffffff;
      --page-max: 900px;
      --page-pad: 56px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      font-size: 15px;
      line-height: 1.6;
      color: var(--green);
      background: var(--bg);
      -webkit-font-smoothing: antialiased;
    }

    .page {
      max-width: var(--page-max);
      margin: 0 auto;
      padding: 72px var(--page-pad) 96px;
    }

    /* ── Action bar ── */
    .action-bar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
      background: rgba(31, 76, 52, 0.92);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 var(--page-pad);
      max-width: 100%;
    }

    .action-bar-inner {
      max-width: var(--page-max);
      margin: 0 auto;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .btn-back {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      transition: color 0.2s;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-back:hover { color: #fff; }

    /* ── CV Header ── */
    .cv-header {
      padding-bottom: 48px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 0;
    }

    .cv-eyebrow {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .cv-name {
      font-size: clamp(40px, 6vw, 64px);
      font-weight: 700;
      letter-spacing: -1.5px;
      color: var(--green);
      line-height: 1.05;
      margin-bottom: 20px;
    }

    .cv-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      align-items: center;
    }

    .cv-meta-item {
      font-size: 13px;
      color: var(--text-muted);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: color 0.2s;
    }

    .cv-meta-item:hover { color: var(--green); }

    .cv-meta-dot {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--border);
      flex-shrink: 0;
    }

    /* ── Sections ── */
    .cv-section {
      padding-top: 56px;
    }

    .section-label {
      display: block;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 3px;
      text-transform: lowercase;
      color: var(--text-muted);
      margin-bottom: 32px;
    }

    /* ── About ── */
    .cv-about-text {
      font-size: clamp(16px, 2vw, 18px);
      color: var(--text-secondary);
      line-height: 1.75;
      max-width: 680px;
    }

    /* ── Skills / Experience / Education rows ── */
    .cv-rows {
      list-style: none;
    }

    .cv-row {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 32px;
      padding: 24px 0;
      border-top: 1px solid var(--border);
      align-items: start;
    }

    .cv-row-label {
      font-size: 13px;
      color: var(--text-muted);
      font-weight: 400;
      padding-top: 3px;
      font-variant-numeric: tabular-nums;
      line-height: 1.5;
    }

    .cv-row-content {}

    /* Skills row: category is the left label */
    .cv-row-cat {
      font-size: 14px;
      font-weight: 600;
      color: var(--green);
      padding-top: 3px;
    }

    .cv-row-items {
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.7;
    }

    /* Experience / Education */
    .cv-row-role {
      font-size: 16px;
      font-weight: 600;
      color: var(--green);
      margin-bottom: 3px;
    }

    .cv-row-org {
      font-size: 14px;
      color: var(--sage);
      font-weight: 500;
      margin-bottom: 10px;
    }

    .cv-row-desc {
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.7;
    }

    .cv-row-note {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.6;
      font-style: italic;
    }

    /* ── Footer ── */
    .cv-footer {
      margin-top: 72px;
      padding-top: 24px;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .cv-footer-left {
      font-size: 12px;
      color: var(--text-muted);
    }

    .cv-footer-right {
      font-size: 12px;
      color: var(--text-muted);
    }

    /* ── Print ── */
    @media print {
      :root {
        --bg: #fff;
        --page-pad: 0px;
      }

      @page {
        margin: 18mm 18mm 18mm 18mm;
      }

      body { background: #fff; font-size: 12px; }
      .action-bar { display: none; }
      .page { padding: 0; max-width: 100%; }
      .cv-name { font-size: 32px; letter-spacing: -0.5px; }
      .cv-section { padding-top: 32px; }
      .cv-row { padding: 16px 0; }
      a { color: inherit !important; text-decoration: none !important; }
    }

    /* ── Responsive ── */
    @media (max-width: 640px) {
      :root { --page-pad: 24px; }

      .page { padding-top: 72px; }

      .action-bar { padding: 0 24px; }

      .cv-row {
        grid-template-columns: 1fr;
        gap: 6px;
      }

      .cv-row-label { padding-top: 0; }

      .cv-meta { gap: 12px; }
      .cv-meta-dot { display: none; }
    }
  </style>
  <script is:inline>
    window.addEventListener('load', function () {
      setTimeout(function () {
        window.print();
        if (window.opener && !window.opener.closed) {
          window.close();
        }
      }, 400);
    });
  </script>

  <!-- Umami Analytics -->
  <script defer src="https://cloud.umami.is/script.js" data-website-id="bebfd6cf-a2f7-4938-8160-0ab23277a8ee"></script>
</head>
<body>

  <div class="action-bar">
    <div class="action-bar-inner">
      <a href="/" class="btn-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 5-7 7 7 7"/></svg>
        Back
      </a>
    </div>
  </div>

  <div class="page">

    <!-- Header -->
    <header class="cv-header">
      <p class="cv-eyebrow">{siteConfig.eyebrow}</p>
      <h1 class="cv-name">{siteConfig.name}</h1>
      <div class="cv-meta">
        <a href={`mailto:${siteConfig.email}`} class="cv-meta-item">{siteConfig.email}</a>
        <span class="cv-meta-dot"></span>
        <a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`} class="cv-meta-item">{siteConfig.phone}</a>
        <span class="cv-meta-dot"></span>
        <span class="cv-meta-item">{siteConfig.location}</span>
        <span class="cv-meta-dot"></span>
        <a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer" class="cv-meta-item">LinkedIn →</a>
      </div>
    </header>

    <!-- Profile -->
    <section class="cv-section">
      <span class="section-label">profile</span>
      <p class="cv-about-text">{siteConfig.about}</p>
    </section>

    <!-- Skills -->
    <section class="cv-section">
      <span class="section-label">skills</span>
      <ul class="cv-rows">
        {siteConfig.skills.map((s) => (
          <li class="cv-row">
            <span class="cv-row-cat">{s.category}</span>
            <span class="cv-row-items">{s.items}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Experience -->
    <section class="cv-section">
      <span class="section-label">experience</span>
      <ul class="cv-rows">
        {siteConfig.experience.map((e) => (
          <li class="cv-row">
            <span class="cv-row-label">{e.period}</span>
            <div class="cv-row-content">
              <p class="cv-row-role">{e.role}</p>
              <p class="cv-row-org">{e.company}</p>
              <p class="cv-row-desc">{e.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Education -->
    <section class="cv-section">
      <span class="section-label">education</span>
      <ul class="cv-rows">
        {siteConfig.education.map((e) => (
          <li class="cv-row">
            <span class="cv-row-label">{e.period}</span>
            <div class="cv-row-content">
              <p class="cv-row-role">{e.degree}</p>
              <p class="cv-row-org">{e.institution}</p>
              {e.note && <p class="cv-row-note">{e.note}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <footer class="cv-footer">
      <span class="cv-footer-left">perinaj.com</span>
      <span class="cv-footer-right">© {year} {siteConfig.name}</span>
    </footer>

  </div>
</body>
</html>
