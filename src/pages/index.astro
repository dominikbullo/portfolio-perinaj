---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import Education from "../components/Education.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{siteConfig.name} — {siteConfig.role} · IBM · Stockholm</title>
    <meta name="description" content={siteConfig.description} />
    <meta name="keywords" content="Nordic Operations Manager, IBM, Nordcloud, Stockholm, Sweden, Operations Manager, P&L Ownership, Nordic Offices, Sustainability, ESG, EU Climate Policy, PFAS Regulation, Baltic Sea, Baltic Sea Region Youth Forum, European Parliament, European Commission, Grant Management, SIDA, EU Structural Funds, Workplace Strategy, Procurement, Swedish speaking, multilingual, 6 languages, Stockholm University, MSc, Barbora Perinajova, Barbora Perinajová, perinaj.com" />
    <meta name="author" content={siteConfig.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://perinaj.com" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={`${siteConfig.name} — ${siteConfig.role}`} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:url" content="https://perinaj.com" />
    <meta property="og:image" content="https://perinaj.com/barbora.jpg" />
    <meta property="og:locale" content="en_SE" />
    <meta property="profile:first_name" content="Barbora" />
    <meta property="profile:last_name" content="Perinajová" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${siteConfig.name} — ${siteConfig.role}`} />
    <meta name="twitter:description" content={siteConfig.description} />
    <meta name="twitter:image" content="https://perinaj.com/barbora.jpg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" is:inline>{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Barbora Perinajová",
      "alternateName": ["Barbora Perinajova", "Barbora Perinaj"],
      "jobTitle": "Nordic Operations Manager",
      "description": "Nordic Operations Manager at Nordcloud, an IBM Company, responsible for 5 Nordic offices across Sweden, Denmark, and Norway with full P&L ownership. Sustainability advocate and EU climate policy expert; elected member, Baltic Sea Region Youth Forum Climate & Environment Working Group; invited speaker at European Commission pre-COP30 workshop (Brussels, 2024) and CBSS Youth Ministerial (Warsaw, 2024). Former European Parliament Schuman Trainee (Agriculture & Trade Committees). MSc Globalisation, Environment & Social Change, Stockholm University (2023). Fluent in Swedish, English, Czech, Slovak, Danish, and Norwegian.",
      "url": "https://perinaj.com",
      "email": siteConfig.email,
      "telephone": siteConfig.phone,
      "image": "https://perinaj.com/barbora.jpg",
      "worksFor": {
        "@type": "Organization",
        "name": "Nordcloud, an IBM Company",
        "url": "https://nordcloud.com",
        "parentOrganization": {
          "@type": "Organization",
          "name": "IBM",
          "url": "https://ibm.com"
        }
      },
      "hasOccupation": {
        "@type": "Occupation",
        "name": "Operations Manager",
        "occupationLocation": { "@type": "Country", "name": "Sweden" },
        "description": "P&L ownership for 5 Nordic offices; vendor contract management, sustainability procurement, cross-border operations across Sweden, Denmark, and Norway"
      },
      "memberOf": [
        {
          "@type": "Organization",
          "name": "Baltic Sea Region Youth Forum",
          "description": "Elected member, Climate & Environment Working Group — PFAS regulation and EU nature restoration policy advocacy"
        },
        {
          "@type": "Organization",
          "name": "Council of the Baltic Sea States (CBSS) Youth Advisory Network"
        }
      ],
      "award": [
        "European Commission pre-COP30 Workshop Speaker, Brussels 2024",
        "CBSS Youth Ministerial Speaker, Warsaw 2024"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Stockholm",
        "addressRegion": "Stockholm County",
        "addressCountry": "SE"
      },
      "sameAs": [siteConfig.linkedin],
      "knowsLanguage": [
        { "@type": "Language", "name": "Swedish", "alternateName": "sv" },
        { "@type": "Language", "name": "English", "alternateName": "en" },
        { "@type": "Language", "name": "Czech", "alternateName": "cs" },
        { "@type": "Language", "name": "Slovak", "alternateName": "sk" },
        { "@type": "Language", "name": "Danish", "alternateName": "da" },
        { "@type": "Language", "name": "Norwegian", "alternateName": "no" }
      ],
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "Stockholm University",
          "url": "https://www.su.se"
        },
        {
          "@type": "CollegeOrUniversity",
          "name": "Tampere University",
          "url": "https://www.tuni.fi"
        }
      ],
      "hasCredential": [
        {
          "@type": "EducationalOccupationalCredential",
          "name": "MSc Globalisation, Environment & Social Change",
          "credentialCategory": "degree",
          "educationalLevel": "Master",
          "dateCreated": "2023",
          "recognizedBy": {
            "@type": "CollegeOrUniversity",
            "name": "Stockholm University"
          }
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "European Parliament Traineeship",
          "credentialCategory": "training",
          "recognizedBy": {
            "@type": "Organization",
            "name": "European Parliament",
            "url": "https://www.europarl.europa.eu"
          }
        }
      ],
      "knowsAbout": [
        "Nordic Operations Management", "P&L Ownership",
        "Multi-site Facilities Management", "Vendor Contract Management",
        "Procurement Strategy", "Budget Forecasting", "Cost Control",
        "Workplace Strategy", "Cross-border Operations",
        "EU Green Deal", "EU Climate Policy", "PFAS Regulation",
        "Baltic Sea Action Plan", "Baltic Sea Governance",
        "Circular Economy", "Nature Restoration Policy",
        "Sustainability Strategy", "ESG", "Climate Finance",
        "EU Structural Funds", "Grant Management", "SIDA Funding",
        "Stakeholder Engagement", "Policy Analysis",
        "Multi-stakeholder Facilitation", "Institutional Fundraising",
        "IBM", "Nordcloud", "Nordic Market", "Sweden", "Stockholm"
      ]
    })}</script>
    <script is:inline>
      function downloadCV(e) {
        e.preventDefault();
        window.open('/cv', '_blank');
      }
    </script>
    <script is:inline>
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, [L, ar[1], ar[2]])} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", {origin:"https://cal.com"});
      Cal("ui", {"styles":{"branding":{"brandColor":"#94A187"}},"hideEventTypeDetails":false,"layout":"month_view"});
    </script>
  </head>
  <body>
    <Header />
    <Hero />
    <main>
      <About />
      <Experience />
      <Projects />
      <Skills />
      <Education />
      <Contact />
    </main>
    <Footer />
  <script is:inline>
    (function () {
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            obs.unobserve(e.target);
          }
        });
      }, { threshold: 0.08 });
      document.querySelectorAll('.reveal').forEach(function (el) { obs.observe(el); });
    })();
  </script>
  </body>
</html>
