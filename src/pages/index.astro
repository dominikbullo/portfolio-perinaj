---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import Education from "../components/Education.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

const ogImage = new URL('/og.png', Astro.url).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1f4c34" />

    <!-- Primary SEO -->
    <title>{siteConfig.name} — {siteConfig.role} · IBM · Stockholm</title>
    <meta name="description" content={siteConfig.description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href="https://perinaj.com/" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Barbora Perinajová" />
    <meta property="og:title" content={`${siteConfig.name} — ${siteConfig.role}`} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:url" content="https://perinaj.com/" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:alt" content="Barbora Perinajová — Nordic Operations Manager" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:locale:alternate" content="sv_SE" />
    <meta property="profile:first_name" content="Barbora" />
    <meta property="profile:last_name" content="Perinajová" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${siteConfig.name} — ${siteConfig.role}`} />
    <meta name="twitter:description" content={siteConfig.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Barbora Perinajová — Nordic Operations Manager" />

    <!-- LLM / AI crawler discovery -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt — AI-readable profile" />

    <!-- Preload critical above-the-fold image -->
    <link rel="preload" as="image" href="/barbora.jpg" fetchpriority="high" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD structured data — @graph with linked entities -->
    <script type="application/ld+json" is:inline>{JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [

        /* ── Website ── */
        {
          "@type": "WebSite",
          "@id": "https://perinaj.com/#website",
          "url": "https://perinaj.com",
          "name": "Barbora Perinajová",
          "description": "Personal portfolio and professional profile of Barbora Perinajová, Nordic Operations Manager at Nordcloud (IBM), Stockholm.",
          "inLanguage": "en",
          "publisher": { "@id": "https://perinaj.com/#person" }
        },

        /* ── ProfilePage ── */
        {
          "@type": "ProfilePage",
          "@id": "https://perinaj.com/#webpage",
          "url": "https://perinaj.com",
          "name": "Barbora Perinajová — Nordic Operations Manager · IBM · Stockholm",
          "description": "Nordic Operations Manager at Nordcloud (IBM). P&L lead for 5 Nordic offices. EU Commission speaker. Baltic Sea Region Youth Forum. MSc Stockholm University. 6 languages.",
          "inLanguage": "en",
          "isPartOf": { "@id": "https://perinaj.com/#website" },
          "about": { "@id": "https://perinaj.com/#person" },
          "mainEntity": { "@id": "https://perinaj.com/#person" },
          "datePublished": "2025-05-11",
          "dateModified": new Date().toISOString().slice(0, 10)
        },

        /* ── Person ── */
        {
          "@type": "Person",
          "@id": "https://perinaj.com/#person",
          "name": "Barbora Perinajová",
          "alternateName": ["Barbora Perinajova", "Barbora Perinaj"],
          "givenName": "Barbora",
          "familyName": "Perinajová",
          "jobTitle": "Nordic Operations Manager",
          "description": "Nordic Operations Manager at Nordcloud, an IBM Company — sole operational lead for 5 Nordic offices (Stockholm, Gothenburg, Malmö, Copenhagen, Oslo) with full P&L ownership. Sustainability advocate; elected member of Baltic Sea Region Youth Forum Climate & Environment Working Group; invited speaker at European Commission pre-COP30 workshop (Brussels 2024) and CBSS Youth Ministerial (Warsaw 2024). Former European Parliament trainee (Agriculture & Trade Committees, Brussels). MSc Globalisation, Environment & Social Change, Stockholm University (2023). Fluent in 6 languages: Swedish, English, Czech, Slovak, Danish, Norwegian.",
          "url": "https://perinaj.com",
          "email": siteConfig.email,
          "telephone": siteConfig.phone.replace(/\s/g, ''),
          "image": {
            "@type": "ImageObject",
            "@id": "https://perinaj.com/#person-image",
            "url": "https://perinaj.com/barbora.jpg",
            "contentUrl": "https://perinaj.com/barbora.jpg",
            "width": 800,
            "height": 800,
            "caption": "Barbora Perinajová — Nordic Operations Manager"
          },
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Stockholm",
            "addressRegion": "Stockholm County",
            "addressCountry": "SE"
          },
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "professional",
            "email": siteConfig.email,
            "telephone": siteConfig.phone.replace(/\s/g, ''),
            "availableLanguage": ["Swedish", "English", "Czech", "Slovak"]
          },
          "worksFor": [
            {
              "@type": "EmployeeRole",
              "@id": "https://perinaj.com/#role-nordcloud",
              "roleName": "Nordic Operations Manager",
              "startDate": "2025-10",
              "description": "Sole P&L lead for IBM's 5 Nordic offices across SE/DK/NO; budget forecasting, vendor negotiations, sustainability procurement, ESG compliance",
              "memberOf": { "@id": "https://perinaj.com/#nordcloud" }
            },
            {
              "@type": "EmployeeRole",
              "@id": "https://perinaj.com/#role-ep",
              "roleName": "Parliamentary Trainee",
              "startDate": "2020-08",
              "endDate": "2021-01",
              "description": "Competitive EU traineeship — Committees on Agriculture, Rural Development and International Trade. Legislative analysis on Farm to Fork Strategy, circular economy, trade. Fewer than 300 trainees selected EU-wide per intake.",
              "memberOf": {
                "@type": "Organization",
                "@id": "https://perinaj.com/#european-parliament",
                "name": "European Parliament",
                "url": "https://www.europarl.europa.eu",
                "sameAs": "https://www.wikidata.org/wiki/Q8889"
              }
            }
          ],
          "hasOccupation": {
            "@type": "Occupation",
            "name": "Operations Manager",
            "occupationLocation": { "@type": "Country", "name": "Sweden" },
            "description": "Full P&L ownership for 5 Nordic offices; vendor contract management, sustainability-aligned procurement, cross-border operations across Sweden, Denmark, and Norway"
          },
          "memberOf": { "@id": "https://perinaj.com/#bsryf" },
          "alumniOf": [
            {
              "@type": "CollegeOrUniversity",
              "@id": "https://www.su.se",
              "name": "Stockholm University",
              "url": "https://www.su.se",
              "sameAs": "https://www.wikidata.org/wiki/Q221645"
            },
            {
              "@type": "CollegeOrUniversity",
              "@id": "https://www.tuni.fi",
              "name": "Tampere University",
              "url": "https://www.tuni.fi",
              "sameAs": "https://www.wikidata.org/wiki/Q1105677"
            }
          ],
          "hasCredential": [
            {
              "@type": "EducationalOccupationalCredential",
              "name": "MSc Globalisation, Environment & Social Change",
              "credentialCategory": "degree",
              "educationalLevel": "Master",
              "dateCreated": "2023",
              "recognizedBy": { "@id": "https://www.su.se" }
            },
            {
              "@type": "EducationalOccupationalCredential",
              "name": "European Parliament Traineeship",
              "credentialCategory": "training",
              "recognizedBy": { "@id": "https://perinaj.com/#european-parliament" }
            }
          ],
          "award": [
            "European Commission Pre-COP30 Workshop Speaker, Brussels 2025",
            "CBSS Youth Ministerial Speaker, Warsaw 2026"
          ],
          "performerIn": [
            { "@id": "https://perinaj.com/#event-cop30-workshop" },
            { "@id": "https://perinaj.com/#event-cbss-ministerial" }
          ],
          "sameAs": [siteConfig.linkedin],
          "knowsLanguage": [
            { "@type": "Language", "name": "Swedish", "alternateName": "sv" },
            { "@type": "Language", "name": "English", "alternateName": "en" },
            { "@type": "Language", "name": "Czech", "alternateName": "cs" },
            { "@type": "Language", "name": "Slovak", "alternateName": "sk" },
            { "@type": "Language", "name": "Danish", "alternateName": "da" },
            { "@type": "Language", "name": "Norwegian", "alternateName": "no" }
          ],
          "knowsAbout": [
            "Nordic Operations Management", "P&L Ownership",
            "Multi-site Facilities Management", "Vendor Contract Management",
            "Procurement Strategy", "Budget Forecasting", "Cost Control",
            "Workplace Strategy", "Cross-border Operations",
            "EU Green Deal", "EU Climate Policy", "PFAS Regulation",
            "Baltic Sea Action Plan", "Baltic Sea Governance",
            "Circular Economy", "Nature Restoration Policy",
            "Sustainability Strategy", "ESG", "Climate Finance",
            "EU Structural Funds", "SIDA Funding", "Grant Management",
            "Stakeholder Engagement", "Policy Analysis",
            "Multi-stakeholder Facilitation", "Institutional Fundraising",
            "IBM", "Nordcloud", "Nordic Market", "Sweden", "Stockholm"
          ]
        },

        /* ── Nordcloud / IBM ── */
        {
          "@type": "Organization",
          "@id": "https://perinaj.com/#nordcloud",
          "name": "Nordcloud, an IBM Company",
          "url": "https://nordcloud.com",
          "sameAs": "https://www.linkedin.com/company/nordcloud/",
          "parentOrganization": {
            "@type": "Organization",
            "@id": "https://perinaj.com/#ibm",
            "name": "IBM",
            "legalName": "International Business Machines Corporation",
            "url": "https://ibm.com",
            "sameAs": "https://www.wikidata.org/wiki/Q37156"
          }
        },

        /* ── Baltic Sea Region Youth Forum ── */
        {
          "@type": "Organization",
          "@id": "https://perinaj.com/#bsryf",
          "name": "Baltic Sea Region Youth Forum",
          "url": "https://bsryf.org",
          "sameAs": "https://bsryf.org",
          "description": "CBSS-affiliated intergovernmental youth governance forum covering 11 Baltic Sea states; Climate & Environment Working Group focuses on PFAS regulation and EU nature restoration policy",
          "memberOf": {
            "@type": "Organization",
            "name": "Council of the Baltic Sea States (CBSS)",
            "url": "https://cbss.org"
          }
        },

        /* ── Event: EU Commission Pre-COP30 ── */
        {
          "@type": "Event",
          "@id": "https://perinaj.com/#event-cop30-workshop",
          "name": "European Commission Pre-COP30 Climate Workshop",
          "description": "High-level European Commission workshop on EU climate policy, PFAS regulation, and nature restoration ahead of COP30. Baltic Sea Region Youth Forum delegates presented youth recommendations to EU officials.",
          "startDate": "2025-10",
          "eventStatus": "https://schema.org/EventScheduled",
          "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
          "location": {
            "@type": "Place",
            "name": "European Commission, Brussels",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Brussels",
              "addressCountry": "BE"
            }
          },
          "organizer": {
            "@type": "Organization",
            "name": "European Commission",
            "url": "https://ec.europa.eu",
            "sameAs": "https://www.wikidata.org/wiki/Q8880"
          },
          "performer": { "@id": "https://perinaj.com/#person" },
          "about": ["PFAS regulation", "EU Climate Policy", "Nature Restoration", "COP30"]
        },

        /* ── Event: CBSS Youth Ministerial Warsaw ── */
        {
          "@type": "Event",
          "@id": "https://perinaj.com/#event-cbss-ministerial",
          "name": "CBSS Youth Ministerial",
          "description": "Council of the Baltic Sea States Youth Ministerial in Warsaw — Baltic Sea Region Youth Forum delegates shaped intergovernmental recommendations on climate, digitalisation, and Baltic Sea connectivity.",
          "startDate": "2026-04",
          "eventStatus": "https://schema.org/EventScheduled",
          "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
          "location": {
            "@type": "Place",
            "name": "Warsaw",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Warsaw",
              "addressCountry": "PL"
            }
          },
          "organizer": {
            "@type": "Organization",
            "name": "Council of the Baltic Sea States (CBSS)",
            "url": "https://cbss.org"
          },
          "performer": { "@id": "https://perinaj.com/#person" }
        },

        /* ── BreadcrumbList ── */
        {
          "@type": "BreadcrumbList",
          "@id": "https://perinaj.com/#breadcrumb",
          "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://perinaj.com/" }]
        }

      ]
    })}</script>
    <script is:inline>
      function downloadCV(e) {
        e.preventDefault();
        window.open('/cv', '_blank');
      }
    </script>
    <!-- Umami Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="bebfd6cf-a2f7-4938-8160-0ab23277a8ee"></script>
  </head>
  <body>
    <Header />
    <Hero />
    <main>
      <About />
      <Experience />
      <Projects />
      <Skills />
      <Education />
      <Contact />
    </main>
    <Footer />
  <script is:inline>
    (function () {
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            obs.unobserve(e.target);
          }
        });
      }, { threshold: 0.08 });
      document.querySelectorAll('.reveal').forEach(function (el) { obs.observe(el); });
    })();
  </script>
  <script is:inline>
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, [L, ar[1], ar[2]])} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", {origin:"https://cal.com"});
    Cal("ui", {"styles":{"branding":{"brandColor":"#94A187"}},"hideEventTypeDetails":false,"layout":"month_view"});
  </script>
  </body>
</html>
