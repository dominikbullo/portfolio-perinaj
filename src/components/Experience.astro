---
import { siteConfig } from "../config";
---

<section id="experience">
  <div class="container">
    <span class="section-label reveal">experience</span>
    <ul class="exp-list">
      {siteConfig.experience.map((item, i) => {
        const isCurrent = item.period.includes('Present');
        return (
          <li class={`exp-item reveal${isCurrent ? ' exp-current' : ''}`} style={`--delay: ${i * 0.08}s`}>
            <span class="exp-date">
              {isCurrent && <span class="now-dot" aria-label="Current role"></span>}
              {item.period}
            </span>
            <div class="exp-content">
              <p class="exp-role">{item.role}</p>
              <p class="exp-company">{item.company}</p>
              <p class="exp-desc">{item.description}</p>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .exp-list {
    list-style: none;
  }

  .exp-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 32px;
    padding: 28px 0;
    border-top: 1px solid var(--border);
    transition: background 0.2s;
    border-radius: 4px;
  }

  .exp-item:hover {
    background: var(--sage-soft);
    padding-left: 12px;
    padding-right: 12px;
    margin-left: -12px;
    margin-right: -12px;
  }

  .exp-current {
    border-left: 2px solid var(--sage);
    padding-left: 20px;
    margin-left: -22px;
  }

  .exp-current:hover {
    margin-left: -22px;
  }

  .now-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sage);
    margin-right: 7px;
    vertical-align: middle;
    position: relative;
    top: -1px;
    animation: pulse 2.4s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(148, 161, 135, 0.5); }
    50% { box-shadow: 0 0 0 5px rgba(148, 161, 135, 0); }
  }

  .exp-date {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 400;
    padding-top: 4px;
    font-variant-numeric: tabular-nums;
    display: flex;
    align-items: flex-start;
  }

  .exp-role {
    font-size: 17px;
    font-weight: 600;
    color: var(--green);
    margin-bottom: 4px;
  }

  .exp-company {
    font-size: 14px;
    color: var(--sage);
    margin-bottom: 10px;
    font-weight: 500;
  }

  .exp-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 580px) {
    .exp-item {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
