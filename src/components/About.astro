---
import { siteConfig } from "../config";
---

<section id="about">
  <div class="container">
    <span class="section-label">about</span>
    <p class="about-text">{siteConfig.about}</p>
    <ul class="tags">
      {siteConfig.aboutTags.map((tag) => (
        <li class="tag">{tag}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about-text {
    font-size: clamp(18px, 2.5vw, 22px);
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 680px;
    margin-bottom: 36px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .tag {
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 6px 16px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 400;
    background: transparent;
    transition: border-color 0.2s, color 0.2s;
  }

  .tag:hover {
    border-color: rgba(31, 76, 52, 0.35);
    color: var(--green);
  }
</style>
