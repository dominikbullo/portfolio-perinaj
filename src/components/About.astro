---
import { siteConfig } from "../config";
---

<section id="about">
  <div class="container">
    <span class="section-label">about</span>
    <div class="about-grid">
      <div class="about-photo-col">
        <div class="photo-wrap">
          <img
            src={siteConfig.profilePhoto}
            alt={siteConfig.name}
            class="profile-photo"
            loading="lazy"
          />
        </div>
      </div>
      <div class="about-content-col">
        <p class="about-text">{siteConfig.about}</p>
        <ul class="tags">
          {siteConfig.aboutTags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 56px;
    align-items: start;
  }

  .photo-wrap {
    position: sticky;
    top: 80px;
  }

  .profile-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 12px;
    display: block;
    filter: saturate(0.9);
  }

  .about-text {
    font-size: clamp(16px, 2vw, 19px);
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 32px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .tag {
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 6px 16px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 400;
    background: transparent;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .tag:hover {
    border-color: var(--sage);
    color: var(--green);
    background: var(--sage-soft);
  }

  @media (max-width: 680px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .photo-wrap {
      position: static;
      max-width: 200px;
    }
  }
</style>
