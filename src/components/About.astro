---
import { siteConfig } from "../config";
---

<section id="about">
  <div class="container">
    <span class="section-label reveal">about</span>
    <div class="about-content reveal" style="--delay: 0.1s">
      <p class="about-text">{siteConfig.about}</p>
      <ul class="tags">
        {siteConfig.aboutTags.map((tag, i) => (
          <li class={`tag tag-${i % 3} reveal`} style={`--delay: ${0.15 + i * 0.05}s`}>{tag}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about-content {
    max-width: 680px;
  }

  .about-text {
    font-size: clamp(16px, 2vw, 19px);
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 32px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .tag {
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 6px 16px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 400;
    background: transparent;
    transition: border-color 0.25s, color 0.25s, background 0.25s, transform 0.2s;
  }

  /* Variant 1: sage accent */
  .tag-1 {
    border-color: rgba(148, 161, 135, 0.45);
    color: var(--sage);
    background: rgba(148, 161, 135, 0.07);
  }

  /* Variant 2: green accent */
  .tag-2 {
    border-color: rgba(31, 76, 52, 0.3);
    color: var(--green);
    background: rgba(31, 76, 52, 0.05);
    font-weight: 500;
  }

  .tag:hover {
    border-color: var(--sage);
    color: var(--green);
    background: var(--sage-soft);
    transform: translateY(-1px);
  }
</style>
