---
import { siteConfig } from "../config";
---

<section id="about">
  <div class="container">
    <span class="section-label reveal">about</span>
    <div class="about-creds reveal">
      <div class="about-cred">
        <span class="cred-value">Nordcloud · IBM</span>
        <span class="cred-key">Current Employer</span>
      </div>
      <div class="about-cred">
        <span class="cred-value">5 Nordic Countries</span>
        <span class="cred-key">Operational Scope</span>
      </div>
      <div class="about-cred">
        <span class="cred-value">EU Commission</span>
        <span class="cred-key">Pre-COP30 Speaker · 2024</span>
      </div>
      <div class="about-cred">
        <span class="cred-value">Stockholm University</span>
        <span class="cred-key">MSc Geography · 2023</span>
      </div>
    </div>
    <div class="about-content reveal" style="--delay: 0.1s">
      <p class="about-text">{siteConfig.about}</p>
      <ul class="tags">
        {siteConfig.aboutTags.map((tag, i) => (
          <li class={`tag tag-${i % 3} reveal`} style={`--delay: ${0.15 + i * 0.05}s`}>{tag}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about-creds {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 56px;
  }

  .about-cred {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 24px;
    background: var(--bg);
    transition: background 0.2s;
  }

  .about-cred:hover {
    background: var(--sage-soft);
  }

  .cred-value {
    font-size: 15px;
    font-weight: 700;
    color: var(--green);
    line-height: 1.2;
  }

  .cred-key {
    font-size: 11px;
    font-weight: 400;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .about-content {
    max-width: 100%;
  }

  @media (max-width: 720px) {
    .about-creds {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 420px) {
    .about-creds {
      grid-template-columns: 1fr;
    }
  }

  .about-text {
    font-size: clamp(16px, 2vw, 19px);
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 32px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .tag {
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 6px 16px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 400;
    background: transparent;
    transition: border-color 0.25s, color 0.25s, background 0.25s, transform 0.2s;
  }

  .tag-1 {
    border-color: rgba(148, 161, 135, 0.45);
    color: var(--sage);
    background: rgba(148, 161, 135, 0.07);
  }

  .tag-2 {
    border-color: rgba(31, 76, 52, 0.3);
    color: var(--green);
    background: rgba(31, 76, 52, 0.05);
    font-weight: 500;
  }

  .tag:hover {
    border-color: var(--sage);
    color: var(--green);
    background: var(--sage-soft);
    transform: translateY(-1px);
  }
</style>
