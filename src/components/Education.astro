---
import { siteConfig } from "../config";
---

<section id="education">
  <div class="container">
    <span class="section-label">education</span>
    <ul class="edu-list">
      {siteConfig.education.map((item) => (
        <li class="edu-item">
          <span class="edu-date">{item.period}</span>
          <div class="edu-content">
            <p class="edu-degree">{item.degree}</p>
            <p class="edu-institution">{item.institution}</p>
            {item.note && <p class="edu-note">{item.note}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .edu-list {
    list-style: none;
  }

  .edu-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 32px;
    padding: 28px 0;
    border-top: 1px solid var(--border);
  }

  .edu-date {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 400;
    padding-top: 4px;
    font-variant-numeric: tabular-nums;
  }

  .edu-degree {
    font-size: 17px;
    font-weight: 600;
    color: var(--green);
    margin-bottom: 4px;
  }

  .edu-institution {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }

  .edu-note {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  @media (max-width: 580px) {
    .edu-item {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
