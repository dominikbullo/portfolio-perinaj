---
import { siteConfig } from "../config";
---

<section id="contact">
  <div class="container">
    <span class="section-label reveal">contact</span>
    <div class="contact-grid">
      <div class="contact-text reveal">
        <h2 class="contact-heading">Let's work together</h2>
        <p class="contact-sub">
          Connect via email, phone, or schedule a meeting directly.
        </p>
      </div>
      <div class="contact-actions reveal" style="--delay: 0.12s">
        <a
          class="btn-book"
          data-cal-link={siteConfig.meetingUrl}
          data-cal-config='{"layout":"month_view"}'
          href="#"
          onclick="return false"
        >
          Book a meeting
        </a>
        <div class="contact-links">
          <a href={`mailto:${siteConfig.email}`} class="contact-link">
            <span class="contact-link-label">Email</span>
            <span class="contact-link-value">{siteConfig.email}</span>
          </a>
          <a href={`tel:${siteConfig.phone}`} class="contact-link">
            <span class="contact-link-label">Phone</span>
            <span class="contact-link-value">{siteConfig.phone}</span>
          </a>
          <a
            href={siteConfig.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-link"
          >
            <span class="contact-link-label">LinkedIn</span>
            <span class="contact-link-value">barboraperinajova →</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .contact-heading {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--green);
    margin-bottom: 12px;
    line-height: 1.1;
  }

  .contact-sub {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .btn-book {
    display: inline-block;
    background: var(--sage);
    color: var(--white);
    padding: 13px 32px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
    cursor: pointer;
    align-self: flex-start;
  }

  .btn-book:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .contact-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    text-decoration: none;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    gap: 16px;
    transition: border-color 0.2s, background 0.2s;
    border-radius: 4px;
  }

  .contact-link:hover {
    border-color: var(--sage);
    background: var(--sage-soft);
    padding-left: 10px;
    padding-right: 10px;
    margin-left: -10px;
    margin-right: -10px;
  }

  .contact-link-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: lowercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .contact-link-value {
    font-size: 14px;
    color: var(--green);
    font-weight: 500;
    text-align: right;
    transition: color 0.2s;
  }

  .contact-link:hover .contact-link-value {
    color: var(--sage);
  }

  @media (max-width: 680px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
