---
import { siteConfig } from "../config";
const [firstName, ...rest] = siteConfig.name.split(" ");
const lastName = rest.join(" ");
---

<section id="hero">
  <div class="hero-inner container">
    <p class="eyebrow">{siteConfig.eyebrow}</p>
    <h1 class="name">{firstName}<br />{lastName}</h1>
    <p class="subtitle">
      {siteConfig.role}<br />based in {siteConfig.location}
    </p>
    <div class="cta-row">
      <a
        class="btn-primary"
        data-cal-link={siteConfig.meetingUrl}
        data-cal-config='{"layout":"month_view"}'
        href="#"
        onclick="return false"
      >
        Book a meeting
      </a>
      <a href={`mailto:${siteConfig.email}`} class="btn-link">{siteConfig.email}</a>
      <a
        href={siteConfig.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-link"
      >
        LinkedIn →
      </a>
    </div>
  </div>
</section>

<style>
  section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: var(--green);
    position: sticky;
    top: 0;
    z-index: 1;
    border-bottom: none;
  }

  .hero-inner {
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(249, 247, 235, 0.45);
    margin-bottom: 24px;
  }

  .name {
    font-size: clamp(52px, 8vw, 80px);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -2px;
    color: #f9f7eb;
    margin-bottom: 24px;
  }

  .subtitle {
    font-size: 18px;
    font-weight: 400;
    color: rgba(249, 247, 235, 0.6);
    line-height: 1.6;
    margin-bottom: 48px;
  }

  .cta-row {
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: var(--sage);
    color: #f9f7eb;
    padding: 12px 28px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
    cursor: pointer;
    display: inline-block;
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-link {
    font-size: 13px;
    color: rgba(249, 247, 235, 0.5);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid rgba(249, 247, 235, 0.2);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }

  .btn-link:hover {
    color: #f9f7eb;
    border-color: rgba(249, 247, 235, 0.6);
  }
</style>
