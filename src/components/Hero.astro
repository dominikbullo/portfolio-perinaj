---
import { siteConfig } from "../config";
const [firstName, ...rest] = siteConfig.name.split(" ");
const lastName = rest.join(" ");
---

<section id="hero">
  <div class="glow"></div>
  <div class="hero-inner container">
    <div class="hero-text">
      <p class="eyebrow">{siteConfig.eyebrow}</p>
      <h1 class="name">{firstName}<br />{lastName}</h1>
      <p class="subtitle">
        {siteConfig.role}<br />based in {siteConfig.location}
      </p>
      <div class="hero-stats" aria-label="Key facts">
        <span class="stat-pill">5 Nordic Offices</span>
        <span class="stat-sep">·</span>
        <span class="stat-pill">6 Languages</span>
        <span class="stat-sep">·</span>
        <span class="stat-pill">P&amp;L Ownership</span>
      </div>
      <div class="cta-row">
        <a
          class="btn-primary"
          data-cal-link={siteConfig.meetingUrl}
          data-cal-config='{"layout":"month_view"}'
          href="#"
          onclick="return false"
        >
          Book a meeting
        </a>
        <a href={`mailto:${siteConfig.email}`} class="btn-link">{siteConfig.email}</a>
        <a
          href={siteConfig.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-link"
        >
          LinkedIn →
        </a>
      </div>
    </div>
    <div class="hero-photo-wrap">
      <img
        src={siteConfig.profilePhoto}
        alt={siteConfig.name}
        class="hero-photo"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: var(--green);
    position: sticky;
    top: 0;
    z-index: 1;
    border-bottom: none;
    overflow: hidden;
  }

  /* Subtle ambient glow */
  .glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 10% 60%, rgba(148, 161, 135, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse 40% 50% at 85% 15%, rgba(249, 247, 235, 0.04) 0%, transparent 50%);
    animation: breathe 10s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes breathe {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 64px;
    align-items: center;
    padding-top: 80px;
    padding-bottom: 80px;
    position: relative;
  }

  /* ── Load animations ── */
  .eyebrow {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(249, 247, 235, 0.45);
    margin-bottom: 20px;
    animation: fadeUp 0.8s cubic-bezier(0.16,1,0.3,1) both;
  }

  .name {
    font-size: clamp(48px, 7vw, 76px);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -2px;
    color: #f9f7eb;
    margin-bottom: 24px;
    animation: fadeUp 0.8s 0.1s cubic-bezier(0.16,1,0.3,1) both;
  }

  .subtitle {
    font-size: 17px;
    font-weight: 400;
    color: rgba(249, 247, 235, 0.6);
    line-height: 1.65;
    margin-bottom: 44px;
    animation: fadeUp 0.8s 0.2s cubic-bezier(0.16,1,0.3,1) both;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 36px;
    animation: fadeUp 0.8s 0.28s cubic-bezier(0.16,1,0.3,1) both;
    flex-wrap: wrap;
  }

  .stat-pill {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: rgba(249, 247, 235, 0.55);
    background: rgba(249, 247, 235, 0.07);
    border: 1px solid rgba(249, 247, 235, 0.14);
    padding: 5px 14px;
    border-radius: 100px;
  }

  .stat-sep {
    font-size: 11px;
    color: rgba(249, 247, 235, 0.2);
  }

  .cta-row {
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
    animation: fadeUp 0.8s 0.38s cubic-bezier(0.16,1,0.3,1) both;
  }

  .btn-primary {
    background: var(--sage);
    color: #f9f7eb;
    padding: 12px 28px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
    cursor: pointer;
    display: inline-block;
  }

  .btn-primary:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  .btn-link {
    font-size: 13px;
    color: rgba(249, 247, 235, 0.5);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid rgba(249, 247, 235, 0.2);
    padding-bottom: 2px;
    transition: color 0.25s, border-color 0.25s;
  }

  .btn-link:hover {
    color: #f9f7eb;
    border-color: rgba(249, 247, 235, 0.6);
  }

  /* ── Photo ── */
  .hero-photo-wrap {
    position: relative;
    animation: fadePhoto 1s 0.25s cubic-bezier(0.16,1,0.3,1) both;
  }

  .hero-photo-wrap::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(to top, var(--green) 0%, transparent 100%);
    border-radius: 0 0 16px 16px;
    pointer-events: none;
  }

  .hero-photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center top;
    border-radius: 16px;
    display: block;
    filter: saturate(0.85);
  }

  /* ── Keyframes ── */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @keyframes fadePhoto {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.97);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @media (max-width: 720px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-photo-wrap {
      max-width: 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eyebrow, .name, .subtitle, .cta-row, .hero-photo-wrap {
      animation: none;
    }
    .glow { animation: none; }
  }
</style>
