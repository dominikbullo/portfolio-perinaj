---
import { siteConfig } from "../config";
---

<section id="skills">
  <div class="container">
    <span class="section-label reveal">skills</span>
    <ul class="skills-list">
      {siteConfig.skills.map((item, i) => (
        <li class="skill-row reveal" style={`--delay: ${i * 0.08}s`}>
          <span class="skill-cat">{item.category}</span>
          <span class="skill-items">{item.items}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .skills-list {
    list-style: none;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 32px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    align-items: baseline;
    transition: background 0.2s;
    border-radius: 4px;
  }

  .skill-row:hover {
    background: var(--sage-soft);
    padding-left: 12px;
    padding-right: 12px;
    margin-left: -12px;
    margin-right: -12px;
  }

  .skill-cat {
    font-size: 14px;
    font-weight: 600;
    color: var(--green);
  }

  .skill-items {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 580px) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
