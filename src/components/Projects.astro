---
import { siteConfig } from "../config";
---

<section id="projects">
  <div class="container">
    <h2 class="section-label reveal">featured projects</h2>
    <ul class="proj-grid">
      {siteConfig.projects.map((project, i) => (
        <li class="proj-card reveal" style={`--delay: ${i * 0.1}s`}>
          {project.url ? (
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="proj-inner proj-link">
              <span class="proj-arrow" aria-hidden="true">↗</span>
              <h3 class="proj-title">{project.name}</h3>
              <p class="proj-desc">{project.description}</p>
              <ul class="proj-tags">
                {project.tags.map((tag) => (
                  <li class="proj-tag">{tag}</li>
                ))}
              </ul>
            </a>
          ) : (
            <div class="proj-inner">
              <h3 class="proj-title">{project.name}</h3>
              <p class="proj-desc">{project.description}</p>
              <ul class="proj-tags">
                {project.tags.map((tag) => (
                  <li class="proj-tag">{tag}</li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    list-style: none;
  }

  .proj-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1),
                box-shadow 0.3s cubic-bezier(0.16,1,0.3,1),
                border-color 0.3s,
                background 0.3s;
  }

  .proj-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 40px rgba(31, 76, 52, 0.12);
    border-color: rgba(31, 76, 52, 0.25);
    background: var(--sage-soft);
  }

  .proj-inner {
    display: block;
    padding: 28px;
    text-decoration: none;
    color: inherit;
    position: relative;
    height: 100%;
  }

  .proj-link {
    cursor: pointer;
  }

  .proj-arrow {
    position: absolute;
    top: 24px;
    right: 24px;
    font-size: 18px;
    color: var(--text-muted);
    transition: transform 0.2s, color 0.2s;
  }

  .proj-card:hover .proj-arrow {
    transform: translate(3px, -3px);
    color: var(--sage);
  }

  .proj-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--green);
    margin-bottom: 12px;
    padding-right: 32px;
    line-height: 1.3;
  }

  .proj-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .proj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
  }

  .proj-tag {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: 100px;
    transition: border-color 0.2s, color 0.2s;
  }

  .proj-card:hover .proj-tag {
    border-color: rgba(148, 161, 135, 0.4);
    color: var(--sage);
  }

  @media (max-width: 580px) {
    .proj-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
