---
import { siteConfig } from "../config";
---

<section id="projects">
  <div class="container">
    <span class="section-label">featured projects</span>
    <ul class="proj-grid">
      {siteConfig.projects.map((project) => (
        <li class="proj-card">
          {project.url ? (
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="proj-link">
              <span class="proj-arrow" aria-hidden="true">↗</span>
              <h3 class="proj-title">{project.name}</h3>
              <p class="proj-desc">{project.description}</p>
              <ul class="proj-tags">
                {project.tags.map((tag) => (
                  <li class="proj-tag">{tag}</li>
                ))}
              </ul>
            </a>
          ) : (
            <div class="proj-inner">
              <h3 class="proj-title">{project.name}</h3>
              <p class="proj-desc">{project.description}</p>
              <ul class="proj-tags">
                {project.tags.map((tag) => (
                  <li class="proj-tag">{tag}</li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    list-style: none;
  }

  .proj-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    transition: background 0.2s, border-color 0.2s;
  }

  .proj-card:hover {
    background: var(--green-soft);
    border-color: rgba(31, 76, 52, 0.3);
  }

  .proj-link,
  .proj-inner {
    display: block;
    padding: 28px;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .proj-arrow {
    position: absolute;
    top: 24px;
    right: 24px;
    font-size: 18px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .proj-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--green);
    margin-bottom: 12px;
    padding-right: 32px;
  }

  .proj-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .proj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
  }

  .proj-tag {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: 100px;
  }

  @media (max-width: 580px) {
    .proj-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
